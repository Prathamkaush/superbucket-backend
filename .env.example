NODE_ENV=development
PORT=3030
# Public HTTPS origin used by Firebase to download notification images.
PUBLIC_API_URL=https://apiv1.freeqr.live

DATABASE_URL=mysql://root:@localhost:3306/superbucket

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

SMS_TOKEN_KEY=
SMS_SENDERID=
SMS_TEMPLATEID=
SMS_ROUTE=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

DELHIVERY_TOKEN=
DELHIVERY_BASE_URL=

# Optional cache. Use either Redis protocol URL or Upstash REST credentials.
# Upstash Redis protocol example: rediss://default:password@host.upstash.io:6379
REDIS_URL=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_PREFIX=superbucket:
CACHE_ENABLED=true
