NODE_ENV=development
PORT=3030

DATABASE_URL=mysql://root:@localhost:3306/superbucket

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

SMS_TOKEN_KEY=
SMS_SENDERID=
SMS_TEMPLATEID=
SMS_ROUTE=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

DELHIVERY_TOKEN=
DELHIVERY_BASE_URL=

# Optional Redis cache. Leave REDIS_URL empty for local in-memory fallback.
REDIS_URL=
CACHE_PREFIX=superbucket:
CACHE_ENABLED=true
