// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// -----------------------------------------
//  USER MODEL
// -----------------------------------------
enum UserRole {
  USER
  ADMIN
  SUB_ADMIN
  PICKER
  DELIVERY_PARTNER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ServiceBookingStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  REVISIT_REQUESTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum DietaryType {
  UNSPECIFIED
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String?  @unique
  phone        String?  @unique
  profileImage String?
  passwordHash String?
  googleId     String?  @unique
  isVerified        Boolean  @default(false)
  bankAccountNumber String?
  bankIfsc          String?
  bankAccountName   String?
  createdAt         DateTime @default(now())

  role UserRole @default(USER)
  createdById Int?
  createdBy   User?  @relation("StaffCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdStaff User[] @relation("StaffCreator")
  staffShopId Int?
  staffShop   Shop? @relation("ShopStaff", fields: [staffShopId], references: [id], onDelete: SetNull)

  cartItems CartItem[]
  orders    Order[]
  acceptedOrders Order[] @relation("OrderAcceptedBy")
  dispatchedOrders Order[] @relation("OrderDispatchedBy")
  fulfilledOrders Order[] @relation("OrderFulfilledBy")
  deliveryOrders Order[] @relation("OrderDeliveryPartner")
  ownedShop Shop? @relation("ShopOwner")
  reviews   Review[]
  feedbacks Feedback[]
  contacts  Contact[]
  wishlists Wishlist[]
  addresses UserAddress[]
  pushTokens PushDeviceToken[]
  notifications Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationCreatedBy")
  wallet WalletAccount?
  walletTransactions WalletTransaction[]

  properties    Property[]
  propertyLeads PropertyLead[]

  providerProfile         ServiceProviderProfile?
  customerServiceBookings ServiceBooking[] @relation("ServiceCustomer")
  providerServiceBookings ServiceBooking[] @relation("ServiceProvider")

  @@index([createdById])
  @@index([staffShopId])
}

enum PushDevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationAudience {
  ALL
  USERS
  DELIVERY_PARTNERS
  PROPERTY_OWNERS
}

model PushDeviceToken {
  id         Int                @id @default(autoincrement())
  userId     Int
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String             @unique @db.VarChar(512)
  platform   PushDevicePlatform @default(ANDROID)
  app        String?
  isActive   Boolean            @default(true)
  lastSeenAt DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId])
  @@index([isActive])
}

model Notification {
  id          Int                   @id @default(autoincrement())
  userId      Int?
  user        User?                 @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  audience    NotificationAudience?
  type        String                @default("GENERAL")
  title       String
  body        String                @db.Text
  imageUrl    String?               @db.Text
  data        Json?
  readAt      DateTime?
  sentAt      DateTime?
  createdById Int?
  createdBy   User?                @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([audience, createdAt])
  @@index([readAt])
}

model WalletAccount {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model WalletTransaction {
  id        Int                   @id @default(autoincrement())
  walletId  Int
  wallet    WalletAccount         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId    Int
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      WalletTransactionType
  amount    Decimal               @db.Decimal(10, 2)
  label     String
  reference String?
  createdAt DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([walletId])
}

model Shop {
  id Int @id @default(autoincrement())

  name      String
  phone     String?
  address   String
  city      String
  state     String
  pincode   String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  radiusKm  Int      @default(5)
  isActive  Boolean  @default(true)

  ownerId Int @unique
  owner   User @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  staff  User[]  @relation("ShopStaff")
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pincode])
  @@index([isActive])
  @@index([latitude, longitude])
}

// -----------------------------------------
// LOCAL SERVICE MARKETPLACE
// -----------------------------------------

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packages  ServicePackage[]
  providers ProviderService[]

  @@index([isActive, sortOrder])
}

model ServicePackage {
  id                   Int      @id @default(autoincrement())
  categoryId           Int
  name                 String
  description          String?  @db.Text
  price                Decimal  @db.Decimal(10, 2)
  durationMinutes      Int
  platformFeePercent   Decimal  @default(20) @db.Decimal(5, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings ServiceBooking[]

  @@index([categoryId, isActive])
}

model ServiceProviderProfile {
  id             Int                   @id @default(autoincrement())
  userId         Int                   @unique
  status         ServiceProviderStatus @default(PENDING)
  isOnline       Boolean               @default(false)
  experienceYears Int                  @default(0)
  bio            String?               @db.Text
  city           String?
  serviceRadiusKm Int                  @default(10)
  rejectionReason String?
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  services ProviderService[]

  @@index([status, isOnline])
  @@index([city])
}

model ProviderService {
  providerId Int
  categoryId Int
  createdAt  DateTime @default(now())

  provider ServiceProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
  @@index([categoryId])
}

model ServiceBooking {
  id                 Int                  @id @default(autoincrement())
  bookingNumber      String               @unique
  customerId         Int
  providerId         Int?
  packageId          Int
  status             ServiceBookingStatus @default(PENDING)
  scheduledAt        DateTime
  address             Json
  customerNote        String?              @db.Text
  cancellationReason String?
  serviceName         String
  categoryName        String
  price               Decimal              @db.Decimal(10, 2)
  platformFee         Decimal              @db.Decimal(10, 2)
  providerEarning     Decimal              @db.Decimal(10, 2)
  completionOtp       String
  acceptedAt          DateTime?
  startedAt           DateTime?
  revisitReason       String?              @db.Text
  revisitRequestedAt  DateTime?
  revisitAcceptedAt   DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  rating              Int?
  review              String?              @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  customer User            @relation("ServiceCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  provider User?           @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: SetNull)
  package  ServicePackage  @relation(fields: [packageId], references: [id])

  @@index([customerId, createdAt])
  @@index([providerId, status])
  @@index([packageId, status])
  @@index([status, scheduledAt])
}

// -----------------------------------------
//  CATEGORY LEVELS
// -----------------------------------------

// Level 1: Main Categories (Men / Women / Kids)
model Category {
  id        Int      @id @default(autoincrement())
  name      String
  image     String?
  createdAt DateTime @default(now())

  productTypes ProductType[]
  products     Product[]
}

// Level 2: Product Types (Ethnic / Western / Party Wear)
model ProductType {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  subtypes ProductSubtype[]
  products Product[]
}

// Level 3: Product Sub-Types (Kurtis / Suits / Sarees …)
model ProductSubtype {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  typeId Int
  type   ProductType @relation(fields: [typeId], references: [id])

  products Product[]
}

// -----------------------------------------
//  PRODUCT MODEL
// -----------------------------------------
model Product {
  id                  Int           @id @default(autoincrement())
  title               String
  slug                String?       @unique
  description         String?       @db.Text
  shortDescription    String?       @db.Text
  price               Decimal       @db.Decimal(10, 2)
  gstRate             Decimal       @default(0) @db.Decimal(5, 2)
  estimatedShipping   Int
  discountType        String?
  discountValue       Decimal?      @db.Decimal(10, 2)
  freeShipping        Boolean       @default(false)
  isTrending          Boolean       @default(false)
  isFeatured          Boolean       @default(false)
  isBestSeller        Boolean       @default(false)
  isNewLaunch         Boolean       @default(false)
  isActive            Boolean       @default(true)
  status              ProductStatus @default(ACTIVE)
  stock               Int
  weight              Decimal?      @db.Decimal(6, 2)
  specifications      Json?
  warranty            String?
  shelfLife           String?
  storageInstructions String?       @db.Text
  hsnCode             String?

  // Supplement-specific PDP fields inspired by sports nutrition sites.
  brandName            String?
  productLine          String?
  goal                 String?
  dietaryPreference    String?
  dietaryType          DietaryType @default(UNSPECIFIED)
  tags                 Json?
  proteinType          String?
  servingSize          String?
  servingsPerContainer Int?
  proteinPerServing    Decimal?    @db.Decimal(8, 2)
  bcaaPerServing       Decimal?    @db.Decimal(8, 2)
  eaaPerServing        Decimal?    @db.Decimal(8, 2)
  caloriesPerServing   Decimal?    @db.Decimal(8, 2)
  proteinPercentage    Decimal?    @db.Decimal(5, 2)
  ingredients          String?     @db.Text
  keyBenefits          Json?
  howToUse             String?     @db.Text
  whenToUse            String?     @db.Text
  safetyInformation    String?     @db.Text
  allergenInfo         String?     @db.Text
  certifications       Json?
  fssaiLicense         String?
  countryOfOrigin      String?
  marketedBy           String?     @db.Text
  manufacturedBy       String?     @db.Text
  sellerName           String?
  authenticityNote     String?     @db.Text
  returnPolicy         String?     @db.Text

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  img1 String?
  img2 String?
  img3 String?
  img4 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------- FK ----------
  categoryId Int
  typeId     Int?
  subtypeId  Int?
  seasonId   Int?

  // ---------- BELONGS TO ----------
  category Category        @relation(fields: [categoryId], references: [id])
  type     ProductType?    @relation(fields: [typeId], references: [id])
  subtype  ProductSubtype? @relation(fields: [subtypeId], references: [id])
  season   Season?         @relation(fields: [seasonId], references: [id])

  // ---------- MANY TO MANY (JOIN TABLES) ----------
  productColors    ProductColor[]
  productFabrics   ProductFabric[]
  productOccasions ProductOccasion[]
  productFits      ProductFit[]
  productSleeves   ProductSleeve[]
  productPatterns  ProductPattern[]
  productVendors   ProductVendor[]

  // ---------- OTHERS ----------
  variants        ProductVariant[]
  nutritionFacts  NutritionFact[]
  sizes           ProductSize[]
  influencerItems InfluencerItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlists       Wishlist[]
}

// -----------------------------------------
//  Supplement product variants
//  Examples: Rich Milk Chocolate / 1 kg / 30 servings.
// -----------------------------------------
model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku           String?       @unique
  name          String?
  attributes    Json?
  barcode       String?       @unique
  flavour       String?
  weightLabel   String?
  netQuantity   String?
  servings      Int?
  mrp           Decimal?      @db.Decimal(10, 2)
  price         Decimal       @db.Decimal(10, 2)
  discountType  String?
  discountValue Decimal?      @db.Decimal(10, 2)
  stock         Int
  weightKg      Decimal?      @db.Decimal(6, 2)
  image1        String?
  image2        String?
  image3        String?
  image4        String?
  status        VariantStatus @default(ACTIVE)
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlists  Wishlist[]

  @@index([productId])
  @@index([flavour])
  @@index([weightLabel])
}

// -----------------------------------------
//  Nutrition facts table
//  Examples: Protein 25g, BCAA 5.5g, Energy 110 kcal.
// -----------------------------------------
model NutritionFact {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  amount   String
  unit     String?
  per      String? @default("serving")
  position Int     @default(0)

  @@index([productId])
}

// -----------------------------------------
//  Product Details
// -----------------------------------------
model Color {
  id   Int     @id @default(autoincrement())
  name String
  hex  String? // #FFFFFF
  slug String  @unique

  products ProductColor[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Fabric {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products ProductFabric[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Occasion {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products ProductOccasion[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Season {
  id       Int     @id @default(autoincrement())
  name     String // Summer, Winter, Festive
  slug     String  @unique
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
}

model Fit {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products ProductFit[]

  isActive Boolean @default(true)
}

model Sleeve {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products ProductSleeve[]

  isActive Boolean @default(true)
}

model Pattern {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products ProductPattern[]

  isActive Boolean @default(true)
}

model ProductColor {
  productId Int
  colorId   Int

  product Product @relation(fields: [productId], references: [id])
  color   Color   @relation(fields: [colorId], references: [id])

  @@id([productId, colorId])
  @@index([colorId])
}

model ProductFabric {
  productId Int
  fabricId  Int

  product Product @relation(fields: [productId], references: [id])
  fabric  Fabric  @relation(fields: [fabricId], references: [id])

  @@id([productId, fabricId])
}

model ProductOccasion {
  productId  Int
  occasionId Int

  product  Product  @relation(fields: [productId], references: [id])
  occasion Occasion @relation(fields: [occasionId], references: [id])

  @@id([productId, occasionId])
}

model ProductFit {
  productId Int
  fitId     Int

  product Product @relation(fields: [productId], references: [id])
  fit     Fit     @relation(fields: [fitId], references: [id])

  @@id([productId, fitId])
}

model ProductSleeve {
  productId Int
  sleeveId  Int

  product Product @relation(fields: [productId], references: [id])
  sleeve  Sleeve  @relation(fields: [sleeveId], references: [id])

  @@id([productId, sleeveId])
}

model ProductPattern {
  productId Int
  patternId Int

  product Product @relation(fields: [productId], references: [id])
  pattern Pattern @relation(fields: [patternId], references: [id])

  @@id([productId, patternId])
}

// -----------------------------------------
//  VENDOR MODELS
// -----------------------------------------

enum VendorType {
  MANUFACTURER
  WHOLESALER
  RETAILER
  DISTRIBUTOR
}

model Vendor {
  id                Int        @id @default(autoincrement())
  companyName       String
  contactPersonName String
  contactNumber     String
  emailId           String     @unique
  gstNumber         String?
  address           String
  vendorType        VendorType
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  productVendors ProductVendor[]

  @@index([vendorType])
  @@index([emailId])
}

model ProductVendor {
  id        Int @id @default(autoincrement())
  productId Int
  vendorId  Int

  costPrice  Decimal @db.Decimal(10, 2) // what you bought it for
  fabricType String? // optional: specific fabric for this vendor
  quantity   Int     @default(1) // how many units from this vendor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([productId, vendorId])
  @@index([vendorId])
}

// -----------------------------------------
//  CART ITEMS
// -----------------------------------------
model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  userId    Int
  productId Int
  variantId Int?
  sizeId    Int?
  price     Int
  gstRate   Decimal @default(0) @db.Decimal(5, 2)
  gstAmount Decimal @default(0) @db.Decimal(10, 2)

  weight Float @default(0)

  user    User            @relation(fields: [userId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  size    ProductSize?    @relation(fields: [sizeId], references: [id])
}

// -----------------------------------------
//  ORDERS & ORDER ITEMS
// -----------------------------------------
model Order {
  id Int @id @default(autoincrement())

  totalAmount    Decimal @db.Decimal(10, 2) // items total
  totalGst       Decimal @default(0) @db.Decimal(10, 2)
  shippingCharge Decimal @db.Decimal(10, 2) // NEW
  finalAmount    Decimal @db.Decimal(10, 2) // NEW

  totalWeight      Decimal?  @db.Decimal(6, 2) // NEW (KG)
  courier          String? // DELHIVERY
  trackingId       String?
  confirmedAt      DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  shippingResponse Json?
  acceptedAt       DateTime?
  dispatchedAt     DateTime?
  fulfilledAt      DateTime?
  deliveryPartnerName  String?
  deliveryPartnerPhone String?
  deliveryLatitude     Decimal? @db.Decimal(10, 7)
  deliveryLongitude    Decimal? @db.Decimal(10, 7)
  deliveryLocationUpdatedAt DateTime?
  deliveryOtp          String?
  deliveryOtpVerifiedAt DateTime?
  deliveryMode         String? @default("INSTANT")
  scheduledDeliveryAt  DateTime?
  deliverySlotLabel    String?

  couponCode     String?
  couponDiscount Decimal? @db.Decimal(10, 2)

  paymentMethod   String? // COD | RAZORPAY
  paymentId       String?
  razorpayOrderId String?   @unique
  paidAt          DateTime?

  status    OrderStatus @default(PENDING)
  address   Json
  addressId Int?
  createdAt DateTime    @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  shopId Int?
  shop   Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  acceptedById   Int?
  acceptedBy     User? @relation("OrderAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  dispatchedById Int?
  dispatchedBy   User? @relation("OrderDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  fulfilledById  Int?
  fulfilledBy    User? @relation("OrderFulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)
  deliveryPartnerId Int?
  deliveryPartner   User? @relation("OrderDeliveryPartner", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  reviews  Review[]
  contacts Contact[]

  @@index([acceptedById])
  @@index([dispatchedById])
  @@index([fulfilledById])
  @@index([deliveryPartnerId])
  @@index([shopId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  createdAt DateTime @default(now())

  // SNAPSHOT FIELDS
  price         Decimal  @db.Decimal(10, 2) // final price per unit
  originalPrice Decimal? @db.Decimal(10, 2)
  discountType  String? // PERCENT | FLAT
  discountValue Decimal? @db.Decimal(10, 2)
  gstRate       Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount     Decimal  @default(0) @db.Decimal(10, 2)

  // SIZE SNAPSHOT
  sizeId Int?
  size   ProductSize? @relation(fields: [sizeId], references: [id])

  // SUPPLEMENT VARIANT SNAPSHOT
  variantId         Int?
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  variantName       String?
  variantAttributes Json?
  flavour           String?
  weightLabel       String?
  sku               String?

  // RELATIONS
  orderId   Int
  productId Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// -----------------------------------------
//  ENUMS
// -----------------------------------------
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// -----------------------------------------
//  Settings
// -----------------------------------------
model Settings {
  id              Int      @id @default(autoincrement())
  name            String?
  email           String?
  storeName       String?
  supportEmail    String?
  supportPhone    String?
  address         String?
  logo            String?
  currency        String?  @default("INR")
  maintenanceMode Boolean  @default(false)
  deliverySlotTimes Json?
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------
//  Reviews
// -----------------------------------------
model Review {
  id        Int          @id @default(autoincrement())
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  userId    Int
  productId Int
  orderId   Int?
  createdAt DateTime     @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
}

// -----------------------------------------
//  Feedback
// -----------------------------------------
model Feedback {
  id        Int      @id @default(autoincrement())
  message   String   @db.Text
  page      String?
  createdAt DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// -----------------------------------------
//  Contact
// -----------------------------------------
enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum ContactReason {
  GENERAL
  PAYMENT_FAILED
  ORDER_QUERY
}

model Contact {
  id      Int     @id @default(autoincrement())
  name    String?
  email   String?
  phone   String?
  subject String?
  message String  @db.Text

  reason ContactReason @default(GENERAL)
  status ContactStatus @default(NEW)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

// -----------------------------------------
//  Product sizes
// -----------------------------------------
model ProductSize {
  id    Int      @id @default(autoincrement())
  size  String // S, M, L, XL
  stock Int
  price Decimal? @db.Decimal(10, 2) // optional per-size pricing

  productId  Int
  product    Product     @relation(fields: [productId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlists  Wishlist[]

  @@unique([productId, size])
}

// -----------------------------------------
//  Whishlist
// -----------------------------------------
model Wishlist {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    Int
  productId Int
  variantId Int?
  sizeId    Int?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  size    ProductSize?    @relation(fields: [sizeId], references: [id])

  @@unique([userId, productId, variantId, sizeId])
}

// -----------------------------------------
//  USERS ADDRESS
// -----------------------------------------
model UserAddress {
  id     Int @id @default(autoincrement())
  userId Int

  name    String
  phone   String
  street  String
  city    String
  state   String
  pincode String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([latitude, longitude])
}

// -----------------------------------------
//  Coupon
// -----------------------------------------
model Coupon {
  id Int @id @default(autoincrement())

  code  String     @unique // e.g. FIRST10
  type  CouponType // PERCENT | FLAT
  value Decimal    @db.Decimal(10, 2) // 10% or ₹200

  minOrderValue Decimal? @db.Decimal(10, 2) // optional
  maxDiscount   Decimal? @db.Decimal(10, 2) // cap for percent coupons

  usageLimit Int? // total allowed uses
  usedCount  Int  @default(0)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
}

enum CouponType {
  PERCENT
  FLAT
}

// -----------------------------------------
//  Home Offers
// -----------------------------------------
model HomeOffer {
  id Int @id @default(autoincrement())

  title       String
  subtitle    String
  buttonLabel String? @default("Claim")
  code        String?
  icon        String? @default("tag")
  color       String? @default("#E30613")
  imageUrl    String? @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  startsAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
//  INFLUENCER
// -----------------------------------------
model InfluencerItem {
  id Int @id @default(autoincrement())

  homepageSectionId Int
  homepageSection   HomepageSection @relation(fields: [homepageSectionId], references: [id])

  // 🔥 MEDIA MODE
  mediaType MediaSourceType @default(UPLOAD)

  // Upload-based media
  mediaId Int?
  media   Media? @relation(fields: [mediaId], references: [id])

  // Instagram / external embed
  embedUrl String? @db.Text

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  influencerName String?
  ctaText        String? @default("Shop Now")

  position  Int
  createdAt DateTime @default(now())

  @@index([homepageSectionId])
  @@index([productId])
}

enum MediaSourceType {
  UPLOAD
  INSTAGRAM
}

// -----------------------------------------
//  HomePageSection
// -----------------------------------------
model HomepageSection {
  id       Int             @id @default(autoincrement())
  type     HomeSectionType
  title    String?
  config   Json // 🔥 Component-specific data
  position Int // ordering on homepage
  isActive Boolean         @default(true)

  influencerItems InfluencerItem[]
  createdAt       DateTime         @default(now())

  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([position])
}

enum HomeSectionType {
  HERO
  CATEGORY_STRIP
  INFLUENCER
  EDITORIAL
}

// -----------------------------------------
//  Media
// -----------------------------------------
model Media {
  id        Int       @id @default(autoincrement())
  type      MediaType
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime  @default(now())

  influencerItems InfluencerItem[]

  @@index([type])
}

enum MediaType {
  IMAGE
  VIDEO
}

// -----------------------------------------
//  PROPERTY MODELS
// -----------------------------------------

enum PropertyStatus {
  DRAFT
  REVIEW
  LIVE
  SOLD
  RENTED
  REJECTED
}

enum PropertyVerification {
  VERIFIED
  DOCS_PENDING
  NOT_SUBMITTED
}

enum PropertyMode {
  RENT
  SELL
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  HOSTEL
  LAND
  WAREHOUSE
}

enum PropertyFurnished {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum LeadStatus {
  PENDING
  VISIT_BOOKED
  NEGOTIATING
  NEEDS_CALLBACK
  RESOLVED
}

model Property {
  id           Int                  @id @default(autoincrement())
  title        String
  address      String
  pincode      String?
  mode         PropertyMode
  category     PropertyCategory
  price        Decimal              @db.Decimal(15, 2)
  size         String
  floor        String?
  furnished    PropertyFurnished    @default(UNFURNISHED)
  details      String?              @db.Text
  frontImage   String?
  roomsImage   String?
  docsFile     String?
  status       PropertyStatus       @default(DRAFT)
  verification PropertyVerification @default(NOT_SUBMITTED)
  views        Int                  @default(0)
  isAdvertised Boolean              @default(false)


  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads PropertyLead[]

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([mode])
  @@index([pincode])
}

model PropertyLead {
  id         Int        @id @default(autoincrement())
  propertyId Int
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     LeadStatus @default(PENDING)
  message    String?    @db.Text
  visitTime  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([userId])
}
